# Valores ilustrativos. Substitua as credenciais e os secrets antes de usar.
# Carregado por Settings a partir do .env no diretório de execução.
# Os exemplos de JWT abaixo são rejeitados em production.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/dtf_manager

JWT_ACCESS_SECRET=trocar
JWT_REFRESH_SECRET=trocar

JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

ENVIRONMENT=development
MERCADO_PAGO_ACCESS_TOKEN=exemplo-ficticio-substituir
MERCADO_PAGO_WEBHOOK_SECRET=exemplo-ficticio-substituir
MERCADO_PAGO_ENVIRONMENT=test
HOST=0.0.0.0
PORT=8000
