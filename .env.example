# Valores ilustrativos. Substitua as credenciais e os secrets antes de usar.
# Carregado por Settings a partir do .env no diretório de execução.
# Os exemplos de JWT abaixo são rejeitados em production.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/dtf_manager

JWT_ACCESS_SECRET=trocar
JWT_REFRESH_SECRET=trocar
# Pepper do HMAC das chaves de ativação (obrigatório em production; diferente dos JWT).
# Trocar este valor invalida todas as chaves já geradas e ainda não usadas.
ACTIVATION_KEY_SECRET=trocar

JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

ENVIRONMENT=development
MERCADO_PAGO_ACCESS_TOKEN=exemplo-ficticio-substituir
MERCADO_PAGO_WEBHOOK_SECRET=exemplo-ficticio-substituir
MERCADO_PAGO_ENVIRONMENT=test
API_PUBLIC_BASE_URL=https://api.example.com
HOST=0.0.0.0
PORT=8000

# Temporary safe webhook diagnostics (disabled by default)
MERCADO_PAGO_WEBHOOK_CAPTURE=false
MERCADO_PAGO_CHECKOUT_TEST_SELLER=false
# Expected application ID; fictitious example. Confirm token/application privately.
MERCADO_PAGO_APPLICATION_ID=123456789
MERCADO_PAGO_WEBHOOK_DIAGNOSTICS=false

# Rate limit de cadastro, login e ativação de chave.
RATE_LIMIT_ENABLED=true
# Login e ativar-chave, por IP e por rota.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Cadastro: por IP e por e-mail.
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_EMAIL_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# Senhas erradas por e-mail (login + ativar-chave com senha).
RATE_LIMIT_ACCOUNT_REQUESTS=10
RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
# Ligue somente depois de conferir X-Forwarded-For nos logs (README, "Conferir o proxy").
RATE_LIMIT_TRUST_PROXY=false
# Diagnóstico temporário; registra IPs nos logs. Desligue após a conferência.
RATE_LIMIT_DIAGNOSTICS=false

# Somente para python -m scripts.seed_admin; valores fictícios, nunca versione os reais.
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=trocar-por-senha-forte-1
ADMIN_NOME=Administrador
